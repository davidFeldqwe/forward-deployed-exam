FROM node:24-bookworm

# Install system dependencies
RUN apt-get update && apt-get install -y \
  git \
  curl \
  jq \
  && rm -rf /var/lib/apt/lists/*

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
  | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
  && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
  | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
  && apt-get update && apt-get install -y gh \
  && rm -rf /var/lib/apt/lists/*

# Install pnpm globally to avoid runtime Corepack cache permission issues.
RUN npm install -g pnpm@10.34.4

# Rename the base image's "node" user (UID 1000) to "agent".
# This keeps UID 1000 so that --userns=keep-id (Podman) and
# --user 1000:1000 (Docker) map to the correct home directory owner.
RUN usermod -d /home/agent -m -l agent node

# Install Codex CLI globally so Sandcastle's codex(...) provider can invoke it.
USER root
RUN npm install -g @openai/codex
USER agent

# Install Claude Code CLI for the remaining Claude-based helper workflows.
RUN curl -fsSL https://claude.ai/install.sh | bash

# Install Cursor Agent CLI (`agent`) — required by sandcastle.cursor(...)
RUN curl -fsS https://cursor.com/install | bash

# Expose Claude/Cursor on a global path; auto-load auth from repo .env when
# host env forwarding is unavailable in sandboxed runs.
USER root
RUN cat > /usr/local/bin/claude <<'WRAPPER'
#!/bin/bash
if [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ] && [ -f .env ]; then
  CLAUDE_CODE_OAUTH_TOKEN=$(grep "^CLAUDE_CODE_OAUTH_TOKEN=" .env | cut -d= -f2-)
  export CLAUDE_CODE_OAUTH_TOKEN
fi
if [ -z "$GH_TOKEN" ] && [ -f .env ]; then
  GH_TOKEN=$(grep "^GH_TOKEN=" .env | cut -d= -f2-)
  export GH_TOKEN
fi
exec /home/agent/.local/bin/claude "$@"
WRAPPER
RUN cat > /usr/local/bin/agent <<'WRAPPER'
#!/bin/bash
if [ -z "$CURSOR_API_KEY" ] && [ -f .env ]; then
  CURSOR_API_KEY=$(grep "^CURSOR_API_KEY=" .env | cut -d= -f2-)
  export CURSOR_API_KEY
fi
if [ -z "$GH_TOKEN" ] && [ -f .env ]; then
  GH_TOKEN=$(grep "^GH_TOKEN=" .env | cut -d= -f2-)
  export GH_TOKEN
fi
exec /home/agent/.local/bin/agent "$@"
WRAPPER
RUN chmod +x /usr/local/bin/claude /usr/local/bin/agent
USER agent

# Add Claude to PATH
ENV PATH="/usr/local/bin:/home/agent/.local/bin:$PATH"
ENV HOME="/tmp/sandcastle-home"
ENV GIT_CONFIG_GLOBAL="/tmp/sandcastle-home/.gitconfig"

# Sandcastle writes global git config during startup. When Docker maps a
# host UID, /home/agent may not be writable for that UID, so use a writable home.
RUN mkdir -p /tmp/sandcastle-home && chmod 777 /tmp/sandcastle-home

WORKDIR /home/agent

# In worktree sandbox mode, Sandcastle bind-mounts the git worktree at /home/agent/workspace
# and overrides the working directory to /home/agent/workspace at container start.
# Structure your Dockerfile so that /home/agent/workspace can serve as the project root.
ENTRYPOINT ["sleep", "infinity"]
