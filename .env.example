# Placeholders only — never commit a filled-in copy. Copy this file to
# apps/web/.env.local, which is where Next reads it from and which .gitignore
# refuses. The README's Environment table is the whole list, and none of it is
# needed to start: without a key the app still stores your question and says so,
# and the screen itself — snapshot, scoring, answer objects — needs no key at all.

# The agent's model. Anthropic is tried first when both are set; a vendor API key,
# never a subscription credential.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Override the model each vendor answers on. Left empty for the defaults.
ANTHROPIC_MODEL=
OPENAI_MODEL=

# Signs the session cookie. Required in production; development falls back to a
# dev-only value.
AUTH_SECRET=

# Optional, and only for the manual snapshot rebuild: where its BTS downloads
# land, instead of packages/snapshot/.cache.
# INGEST_CACHE_DIR=
